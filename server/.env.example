# Server
PORT=4000
NODE_ENV=development

# MongoDB — local docker-compose instance by default, or an Atlas URI
MONGODB_URI=mongodb://localhost:27017/lifetracker

# Auth — use long random strings in production
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Client origin (for CORS when not using the Vite proxy)
CLIENT_ORIGIN=http://localhost:5173
